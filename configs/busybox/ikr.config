# BusyBox config fragment for the IKR static-init rootfs.
# Applied on top of `make allnoconfig`. Boolean options only — the
# CROSS_COMPILER_PREFIX string option is set separately by the build script
# since it depends on the workspace's CROSS_COMPILE value.
CONFIG_STATIC=y
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_ASH=y
CONFIG_FEATURE_SH_IS_ASH=y
CONFIG_FEATURE_SH_EXTRA_QUIET=y
CONFIG_MOUNT=y
CONFIG_MKDIR=y
CONFIG_ECHO=y
CONFIG_CAT=y
CONFIG_DMESG=y
CONFIG_GREP=y
CONFIG_LS=y
CONFIG_SETSID=y
CONFIG_SLEEP=y
CONFIG_CTTYHACK=y
CONFIG_STTY=y
CONFIG_GETTY=y
CONFIG_MKNOD=y
CONFIG_AWK=y
CONFIG_TEST=y
